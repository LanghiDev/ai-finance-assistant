# Copy to .env (never commit .env) and fill in.
ANTHROPIC_API_KEY=

# claude-haiku-4-5 while developing (cheap), claude-opus-5-5 for the demo.
AGENT_MODEL=claude-haiku-4-5
AGENT_API_URL=http://localhost:8000/api

# Demo customer used by agent/evals/run_questions.py (created by `manage.py seed_demo`).
DEMO_DOCUMENT_NUMBER=78481769
DEMO_DATE_OF_BIRTH=1982-02-05

# Backend. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=hackathon_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
